# ============================================================
# KhetSe — environment configuration template
# Copy to .env and fill in values. NEVER commit the real .env.
# All external integrations are optional: adapters fall back to
# clearly-labelled mock implementations when keys are absent.
# ============================================================

# --- Application ---
# development | demo | production
ENV=development
# Enables demo login, simulated payments/SMS and seeded demo data.
# Forced off automatically when ENV=production.
DEMO_MODE=true
LOG_LEVEL=INFO

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql+psycopg2://khetse:khetse@localhost:5432/khetse

# --- Redis (optional; in-memory fallback when unavailable) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=5

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Market data (Agmarknet via data.gov.in) ---
# Free key: https://data.gov.in (sign up -> API key)
DATA_GOV_IN_API_KEY=

# --- Bhashini speech (ASR / TTS / translation) ---
# Free key: https://bhashini.gov.in (ULCA portal registration)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- Routing ---
# Public demo server by default; self-host via `docker compose --profile routing up`
OSRM_BASE_URL=https://router.project-osrm.org

# --- Weather ---
# open_meteo (no key) | imd (requires IMD API key, IP-bound)
WEATHER_PROVIDER=open_meteo
IMD_API_KEY=

# --- Payments ---
# mock (labelled sandbox, default) | razorpay (test mode keys)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS / Voice ---
# mock (logged in-app) | future real provider adapters
SMS_PROVIDER=mock
VOICE_PROVIDER=mock
